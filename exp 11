#include <iostream>
using namespace std;

double division(int a, int b) {
    if (b == 0) {
        throw "Division by zero condition!";
    }
    return (a / b);
}

int main() {
    int x = 50;
    int y = 0;
    double z = 0;

    try {
        z = division(x, y);
        cout << z << endl;
    } catch (const char* msg) {
        cerr << msg << endl;
        return 0;
    }

// program 2

#include <iostream>
#include <exception>
using namespace std;

class MyException : public exception {
public:
    const char* what() const noexcept override {
        return "Attempted to divide by zero!\n";
    }
};

int main() {
    int x, y;
    cout << "Enter two numbers: ";
    cin >> x >> y;

    try {
        if (y == 0) {
            throw MyException();
        }
        cout << "Result: " << x / y << endl;
    } 
    catch (const exception& e) {
        cout << e.what();
    }

    return 0;
}
    
}


